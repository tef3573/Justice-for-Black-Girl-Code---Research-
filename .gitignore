# Research data
data/raw/*
data/interim/*
data/processed/*
data/final/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/final/.gitkeep

# Safety fallback if working data are placed beneath documentation
docs/data/*

# artifacts
outputs/figures/*
outputs/tables/*
outputs/models/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/models/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Notebooks and editors
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/

# Secrets and restricted files
.env
*.key
*.pem
*restricted-use*
*geocode*
