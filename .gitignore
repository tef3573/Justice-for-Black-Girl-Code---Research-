# Research data
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated artifacts
outputs/figures/*
outputs/tables/*
outputs/models/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/models/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Notebooks and editors
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/

# Secrets and restricted files
.env
*.key
*.pem
*restricted-use*
*geocode*
